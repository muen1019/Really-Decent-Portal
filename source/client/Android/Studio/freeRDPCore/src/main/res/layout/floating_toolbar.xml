<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_toolbar_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true"
    android:background="@drawable/bg_floating_toolbar"
    android:clipToOutline="true"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:padding="4dp">

    <ImageButton
        android:id="@+id/floating_toolbar_handle"
        style="@style/Widget.InputLab.FloatingToolbarButton"
        android:src="@drawable/ic_drag_indicator" />

    <LinearLayout
        android:id="@+id/floating_toolbar_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/floating_toolbar_touch_pointer"
            style="@style/Widget.InputLab.FloatingToolbarButton"
            android:focusable="false"
            android:contentDescription="@string/screen_input_touchpad_description"
            android:src="@drawable/ic_cursor" />

        <ImageButton
            android:id="@+id/floating_toolbar_sys_keyboard"
            style="@style/Widget.InputLab.FloatingToolbarButton"
            android:contentDescription="@string/menu_sys_keyboard"
            android:src="@drawable/ic_keyboard" />

    </LinearLayout>

</LinearLayout>
